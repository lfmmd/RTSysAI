<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RTSysPlugInAdapter</AssemblyName>
    <RootNamespace>RTSys.PlugIn</RootNamespace>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Release\</OutputPath>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <!-- 外部依赖 DLL 由 RTSys 环境提供，Private=false -->
    <Reference Include="TrioSharedLibrary">
      <HintPath>..\..\TrioSharedLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TrioCommunicationsLibrary">
      <HintPath>..\..\TrioCommunicationsLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TrioBaseLib">
      <HintPath>..\..\TrioBaseLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- 业务逻辑（ApiServer / AiService / Handlers / ZMotion*）由 Worker 程序集提供。
         当前采用单进程模式：宿主进程内直接引用 Worker 程序集，不启动独立进程。 -->
    <ProjectReference Include="..\PlugInWorker\PlugInWorker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="PlugInAbi.cs" />
    <Compile Include="PlugInHostAdapter.cs" />
    <Compile Include="PlugInNativeExports.cs" />
    <!-- UI 相关：ChatPanel 留在宿主进程 -->
    <Compile Include="ChatPanel.cs" />
    <!-- PlugInLog / DispatcherHelper / ApiServer 由 PlugInWorker 程序集提供，此处不重复编译 -->
    <!-- Worker 进程生命周期管理（预留，当前单进程模式下不启用） -->
  </ItemGroup>
  <ItemGroup>
    <Content Include="skills\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
