<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RTSysPlugInWorkerTests</AssemblyName>
    <RootNamespace>RTSys.PlugIn.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
